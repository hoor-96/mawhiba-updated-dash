30 ديسمبر", "المتوسط", "600"], ["موهبة 360", "برنامج", "برنامج تطوير الألعاب الإلكترونية", "1 نوفمبر – 1 يناير", "المتوسط", "50"], ["موهبة 360", "برنامج", "برنامج موهبة للملكية الفكرية", "1 نوفمبر – 30 ديسمبر", "الثالث المتوسط والثانوي", "25"]]}, "content": {"values": [["h"], ["التميز", "رسالة نصية", "باقي يومين على إغلاق التسجيل! سجل قبل الإغلاق واستفد من خيار الدفع عبر\"تمارا\"", "https://s.mawhiba.sa/Tam", "الذين قاموا بحفظ نموذج التسجيل لكن لم يتم ارسال النموذج بعد", "1,955", "", "297"], ["التميز", "منشور سوشل ميديا", "لطلبة الصف الثاني الثانوي فقط..\n\n🎓 حلمك بالجامعات العالمية يستاهل.. باقي يومين على إغلاق التسجيل في برنامج \"التميز\"!\n\nأكمل متطلباتك، وسجّل الآن دون اشتراط أداء #مقياس_موهبة.\n\n#برنامج_موهبة_للالتحاق_بالجامعات_المرموقة", "https://s.mawhiba.sa/3W6e2Wu", "", "", "8,352", "219", "26"], ["الكشف عن الموهوبين", "رسالة نصية", "خطوة في الأولمبياد، وخطوة لاكتشاف موهبتك! إذا كان أولمبياد الموهبة الوطني بوابتك للمنافسة، فالبرنامج الوطني للكشف عن الموهوبين بوابتك لاكتشاف قدراتك، والانطلاق نحو برامج نوعية وفرص عالمية.", "https://s.mawhiba.sa/NPG-N", "إعادة استهداف غير المكتملين", "60,935", "", "5,056"], ["الكشف عن الموهوبين", "منشور سوشل ميديا", "وراء كل إنجاز بداية.. واليوم بدايتكم\n\nثقوا بأنفسكم، وتعاملوا مع كل سؤال بهدوء؛ فقد تكون هذه الخطوة بداية رحلة تكتشفون فيها الكثير عن قدراتكم.\n\nدعواتنا لكم بالتوفيق\n#البرنامج_الوطني_للكشف_عن_الموهوبين", "s.mawhiba.sa/NPG-X", "", "", "6,696", "222", "14"], ["بيبراس", "رسالة نصية", "انطلق التسجيل في بيبراس موهبة للمعلوماتية", "https://s.mawhiba.sa/BEB-M", "طلبة المرحلة المتوسطة ", "103,204", "", "6,244"], ["بيبراس", "منشور سوشل ميديا", "خطوات واضحة تبدأ بالتدريب عبر مكتبة بيبراس وحتى خوض التحدي!\nاكتشف خطوات مشاركتك في #بيبراس_موهبة، وطوّر قدراتك في التفكير الحاسوبي خطوة بخطوة.\n\nابدأ رحلتك وسجّل الآن عبر الرابط:", "https://s.mawhiba.sa/BEB-X", "", "", "4,708", "624", "9"], ["موهبة 360", "منشور سوشل ميديا", "تعرّف على البرامج المتاحة ضمن #موهبة360، واستكشف الفرص التعليمية التي تناسب اهتماماتك وتساعدك على تطوير مهاراتك خلال العام الدراسي.\n\nتصفّح البرامج واختر فرصتك القادمة:", "https://x.com/mawhiba/status/2121198436066251010", "", "", "6,389", "3,114", "21"]]}}